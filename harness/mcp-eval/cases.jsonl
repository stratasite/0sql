{"id": "basic_total", "tags": ["basic"], "prompt": "How many contacts were there in total?", "spec": {"projections": [{"field": "Contacts"}]}, "ordered": false}
{"id": "basic_by_site", "tags": ["basic"], "prompt": "Contacts by call center.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts"}]}, "ordered": false}
{"id": "basic_aht_region", "tags": ["basic"], "prompt": "Average handle time by call center region.", "spec": {"projections": [{"field": "Call Center Region"}, {"field": "AHT Mins"}]}, "ordered": false}
{"id": "basic_sla_channel", "tags": ["basic"], "prompt": "What is the service level by contact channel?", "spec": {"projections": [{"field": "Contact Channel"}, {"field": "SLA Rate"}]}, "ordered": false}
{"id": "basic_two_measures", "tags": ["basic"], "prompt": "Contacts and answered count by skill.", "spec": {"projections": [{"field": "Skill"}, {"field": "Contacts"}, {"field": "Answered Count"}]}, "ordered": false}
{"id": "basic_agents_workplace", "tags": ["basic"], "prompt": "How many distinct agents handled contacts, by workplace?", "spec": {"projections": [{"field": "Workplace"}, {"field": "Agents"}]}, "ordered": false}
{"id": "basic_asa_subchannel", "tags": ["basic"], "prompt": "Average speed of answer by contact subchannel.", "spec": {"projections": [{"field": "Contact Subchannel"}, {"field": "ASA Secs"}]}, "ordered": false}
{"id": "basic_cpm_bpo", "tags": ["basic"], "prompt": "Cost per minute for each BPO value, the in-house sites included.", "spec": {"projections": [{"field": "BPO"}, {"field": "Cost Per Minute USD"}]}, "ordered": false}
{"id": "basic_makegood", "tags": ["basic"], "prompt": "Makegood rate and makegood amount per ticket, by call center.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Makegood Rate"}, {"field": "Makegood Amount Per Ticket"}]}, "ordered": false}
{"id": "join_escalating", "tags": ["join"], "prompt": "Contacts by the call center that handled them and the call center they were escalated to.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Escalating Call Center"}, {"field": "Contacts"}]}, "ordered": false}
{"id": "join_customer_region", "tags": ["join"], "prompt": "Contacts by the customer's region (where the contact originated), not the site's region.", "spec": {"projections": [{"field": "Region"}, {"field": "Contacts"}]}, "ordered": false}
{"id": "join_supervisor_then", "tags": ["join"], "prompt": "Contacts by the supervisor the agent reported to on the day of the contact.", "spec": {"projections": [{"field": "Supervisor Name"}, {"field": "Contacts"}]}, "ordered": false}
{"id": "join_escalation_rate", "tags": ["join"], "prompt": "Escalation rate by call center.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Escalation Rate"}]}, "ordered": false}
{"id": "join_skill_channel", "tags": ["join"], "prompt": "Abandon rate by skill channel, meaning the channel the skill is staffed for.", "spec": {"projections": [{"field": "Skill Channel"}, {"field": "Abandon Rate"}]}, "ordered": false}
{"id": "join_recontact", "tags": ["join"], "prompt": "Recontact rate by call center.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Recontact Rate"}]}, "ordered": false}
{"id": "filter_equals", "tags": ["filter"], "prompt": "Contacts by call center, for chat contacts only.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts"}], "filters": [{"field": "Contact Channel", "predicate": "equals", "value": "Chat"}]}, "ordered": false}
{"id": "filter_in_list", "tags": ["filter"], "prompt": "Contacts by top-level ticket disposition for the Telvanta and Conexus sites.", "spec": {"projections": [{"field": "Ticket Disposition Level 0"}, {"field": "Contacts"}], "filters": [{"field": "BPO", "predicate": "in_list", "value": "Telvanta, Conexus"}]}, "ordered": false}
{"id": "filter_exclude", "tags": ["filter"], "prompt": "Contacts by call center, leaving out the in-house sites (BPO INHOUSE).", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts"}], "filters": [{"field": "BPO", "predicate": "does_not_equal", "value": "INHOUSE"}]}, "ordered": false}
{"id": "filter_relative_28d", "tags": ["filter"], "prompt": "Total contacts in the last 28 days.", "spec": {"projections": [{"field": "Contacts"}], "filters": [{"field": "Contact Date", "predicate": "greater_than_or_equal_to", "value": "28d"}]}, "ordered": false}
{"id": "filter_fixed_range", "tags": ["filter"], "prompt": "Contacts per day for September 2026.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "day"}], "order_by": "asc"}, {"field": "Contacts"}], "filters": [{"field": "Contact Date", "predicate": "between", "value": "2026-09-01", "value_end": "2026-09-30"}]}, "ordered": true}
{"id": "filter_starts_with", "tags": ["filter"], "prompt": "Contacts for each skill whose name starts with 'Phone'.", "spec": {"projections": [{"field": "Skill"}, {"field": "Contacts"}], "filters": [{"field": "Skill", "predicate": "starts_with", "value": "Phone"}]}, "ordered": false}
{"id": "filter_measure", "tags": ["filter"], "prompt": "Call centers with more than 700 contacts, with their contact count.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts"}], "filters": [{"field": "Contacts", "predicate": "greater_than", "value": "700"}]}, "ordered": false}
{"id": "filter_gate_list", "tags": ["filter"], "prompt": "Contacts by call center where the resolution gate is Escalated or Follow-up Required.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts"}], "filters": [{"field": "Ticket Resolution Gate", "predicate": "in_list", "value": "Escalated, Follow-up Required"}]}, "ordered": false}
{"id": "filter_is_null", "tags": ["filter"], "prompt": "Contacts by contact subchannel where no chat end state was recorded.", "spec": {"projections": [{"field": "Contact Subchannel"}, {"field": "Contacts"}], "filters": [{"field": "Chat End State", "predicate": "is_null"}]}, "ordered": false}
{"id": "filter_or_tree", "tags": ["filter"], "prompt": "Contacts by call center, keeping Tier 2 skills in EMEA together with every skill in APAC.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts"}], "filters": {"or": [{"and": [{"field": "Escalation Code", "predicate": "equals", "value": "T2"}, {"field": "Call Center Region", "predicate": "equals", "value": "EMEA"}]}, {"field": "Call Center Region", "predicate": "equals", "value": "APAC"}]}}, "ordered": false}
{"id": "filter_two", "tags": ["filter"], "prompt": "Contacts by skill in Lisbon and Dublin between 2026-07-01 and 2026-08-31.", "spec": {"projections": [{"field": "Skill"}, {"field": "Contacts"}], "filters": [{"field": "Call Center", "predicate": "in_list", "value": "Lisbon, Dublin"}, {"field": "Contact Date", "predicate": "between", "value": "2026-07-01", "value_end": "2026-08-31"}]}, "ordered": false}
{"id": "filter_contains", "tags": ["filter"], "prompt": "Contacts by level-1 ticket disposition for dispositions containing the word 'Charge'.", "spec": {"projections": [{"field": "Ticket Disposition Level 1"}, {"field": "Contacts"}], "filters": [{"field": "Ticket Disposition Level 1", "predicate": "contains", "value": "Charge"}]}, "ordered": false}
{"id": "rank_top5_disp", "tags": ["rank"], "prompt": "Top 5 top-level ticket dispositions by contact volume, highest first.", "spec": {"projections": [{"field": "Ticket Disposition Level 0"}, {"field": "Contacts", "order_by": "desc"}], "filters": [{"field": "Ticket Disposition Level 0", "predicate": "top_n", "value": "5", "top_n_measure": "Contacts"}]}, "ordered": true}
{"id": "rank_top3_aht", "tags": ["rank"], "prompt": "The three call centers with the longest average handle time, with their AHT, longest first.", "spec": {"projections": [{"field": "Call Center"}, {"field": "AHT Mins", "order_by": "desc"}], "filters": [{"field": "Call Center", "predicate": "top_n", "value": "3", "top_n_measure": "AHT Mins"}]}, "ordered": true}
{"id": "rank_order_desc", "tags": ["rank"], "prompt": "Call centers ranked by cost per contact, most expensive first.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Cost Per Contact USD", "order_by": "desc"}]}, "ordered": true}
{"id": "rank_limit", "tags": ["rank"], "prompt": "The first 5 skills alphabetically, with their contacts.", "spec": {"projections": [{"field": "Skill", "order_by": "asc"}, {"field": "Contacts"}], "limit": 5}, "ordered": true}
{"id": "rank_top_in_filter", "tags": ["rank"], "prompt": "Among chat contacts only, the top 3 call centers by contacts.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts", "order_by": "desc"}], "filters": [{"field": "Contact Channel", "predicate": "equals", "value": "Chat"}, {"field": "Call Center", "predicate": "top_n", "value": "3", "top_n_measure": "Contacts"}]}, "ordered": true}
{"id": "deco_week_3m", "tags": ["decorator"], "prompt": "Contacts per week since three months ago, in date order (use a relative date).", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "week"}], "order_by": "asc"}, {"field": "Contacts"}], "filters": [{"field": "Contact Date", "predicate": "greater_than_or_equal_to", "value": "3m"}]}, "ordered": true}
{"id": "deco_month", "tags": ["decorator"], "prompt": "Contacts by month.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "month"}]}, {"field": "Contacts"}]}, "ordered": false}
{"id": "deco_extract_hour", "tags": ["decorator"], "prompt": "Contacts by the hour of the day they started.", "spec": {"projections": [{"field": "Contact Start Time", "decorators": [{"type": "extract", "extract": "hour"}]}, {"field": "Contacts"}]}, "ordered": false}
{"id": "deco_month_name", "tags": ["decorator"], "prompt": "Contacts by month name.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "extract", "extract": "month_name"}]}, {"field": "Contacts"}]}, "ordered": false}
{"id": "deco_running_sum", "tags": ["decorator"], "prompt": "Running total of contacts by month, in month order.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "month"}], "order_by": "asc"}, {"field": "Contacts", "decorators": [{"type": "window", "mode": "running", "function": "sum"}]}]}, "ordered": true}
{"id": "deco_moving_avg", "tags": ["decorator"], "prompt": "The 7-day moving average of daily contacts, in date order.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "day"}], "order_by": "asc"}, {"field": "Contacts", "decorators": [{"type": "window", "mode": "moving", "function": "avg", "size": 6}]}]}, "ordered": true, "note": "size is rows preceding: a 7-day average is size 6"}
{"id": "deco_share_total", "tags": ["decorator"], "prompt": "Each call center's share of total contacts.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts", "decorators": [{"type": "contribute"}]}]}, "ordered": false}
{"id": "deco_share_partition", "tags": ["decorator"], "prompt": "Each skill's share of its own contact channel's contacts; show the channel, the skill and the share.", "spec": {"projections": [{"field": "Contact Channel"}, {"field": "Skill"}, {"field": "Contacts", "decorators": [{"type": "contribute", "partition_refs": ["contact-channel"]}]}]}, "ordered": false, "note": "partition_refs takes uids; a name is dropped silently and the share becomes share of total"}
{"id": "deco_mom_prior", "tags": ["decorator"], "prompt": "Monthly contacts with the previous month's contacts beside each month, in month order.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "month"}], "order_by": "asc"}, {"field": "Contacts"}, {"field": "Contacts", "decorators": [{"type": "temporalize", "transform": "month_over_month"}]}]}, "ordered": true}
{"id": "deco_mom_pct", "tags": ["decorator"], "prompt": "Month over month percent change in contacts, by month in order.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "month"}], "order_by": "asc"}, {"field": "Contacts", "decorators": [{"type": "temporalize", "transform": "month_over_month", "percent_change": true}]}]}, "ordered": true}
{"id": "deco_wow", "tags": ["decorator"], "prompt": "Answered count by week with the prior week's answered count, in week order.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "week"}], "order_by": "asc"}, {"field": "Answered Count"}, {"field": "Answered Count", "decorators": [{"type": "temporalize", "transform": "week_over_week"}]}]}, "ordered": true}
{"id": "deco_lag", "tags": ["decorator"], "prompt": "Contacts by month with the previous month's contacts taken with a one-row lag window, in month order.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "month"}], "order_by": "asc"}, {"field": "Contacts"}, {"field": "Contacts", "decorators": [{"type": "window", "mode": "running", "function": "lag", "offset": 1}]}]}, "ordered": true}
{"id": "calc_talk_per_answered", "tags": ["calc"], "prompt": "Average talk seconds per answered contact by call center, computed as a calculation from talk duration and answered count.", "spec": {"projections": [{"field": "Call Center"}, {"alias": "Talk Secs Per Answered", "calculation": true, "sql": "[Talk Duration Secs]@m * 1.0 / nullif([Answered Count]@m, 0)"}]}, "ordered": false}
{"id": "calc_kb_per_contact", "tags": ["calc"], "prompt": "KB articles used per contact by call center region.", "spec": {"projections": [{"field": "Call Center Region"}, {"alias": "KB Articles Per Contact", "calculation": true, "sql": "[KB Articles Used Count]@m * 1.0 / nullif([Contacts]@m, 0)"}]}, "ordered": false}
{"id": "calc_contacts_per_agent", "tags": ["calc"], "prompt": "Contacts per agent by call center.", "spec": {"projections": [{"field": "Call Center"}, {"alias": "Contacts Per Agent", "calculation": true, "sql": "[Contacts]@m * 1.0 / nullif([Agents]@m, 0)"}]}, "ordered": false}
{"id": "calc_hours", "tags": ["calc"], "prompt": "Handled hours (handled minutes divided by 60) by BPO.", "spec": {"projections": [{"field": "BPO"}, {"alias": "Handled Hours", "calculation": true, "sql": "[Handled Minutes]@m / 60"}]}, "ordered": false}
{"id": "calc_over_alias", "tags": ["calc"], "prompt": "By call center: contacts, answered count, and the answered share computed from those two columns.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts", "alias": "Contacts"}, {"field": "Answered Count", "alias": "Answered"}, {"alias": "Answered Share", "calculation": true, "sql": "[Answered] * 1.0 / nullif([Contacts], 0)"}]}, "ordered": false}
{"id": "seg_include", "tags": ["segment"], "prompt": "Contacts by call center, counting only agents who have ever handled a chat contact.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts"}], "segments": [{"name": "Chat agents", "keys": ["Agent User ID"], "filters": [{"field": "Contact Channel", "predicate": "equals", "value": "Chat"}]}]}, "ordered": false}
{"id": "seg_exclude", "tags": ["segment"], "prompt": "Contacts by skill, excluding agents who have ever had a contact escalated (resolution gate Escalated).", "spec": {"projections": [{"field": "Skill"}, {"field": "Contacts"}], "segments": [{"name": "Escalating agents", "mode": "exclude", "keys": ["Agent User ID"], "filters": [{"field": "Ticket Resolution Gate", "predicate": "equals", "value": "Escalated"}]}]}, "ordered": false}
{"id": "seg_apply_to", "tags": ["segment"], "prompt": "By call center: all contacts, and beside it the contacts from agents who handled more than 100 contacts.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts", "alias": "All Contacts"}, {"field": "Contacts", "alias": "Busy Agent Contacts"}], "segments": [{"name": "Busy agents", "keys": ["Agent User ID"], "measures": ["Contacts"], "filters": [{"field": "Contacts", "predicate": "greater_than", "value": "100"}], "apply_to": ["Busy Agent Contacts"]}]}, "ordered": false}
{"id": "seg_top_cohort", "tags": ["segment"], "prompt": "Contacts by call center, restricted to the three busiest skills by contacts as a cohort.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contacts"}], "segments": [{"name": "Top skills", "keys": ["Skill"], "measures": ["Contacts"], "filters": [{"field": "Skill", "predicate": "top_n", "value": "3", "top_n_measure": "Contacts"}]}]}, "ordered": false}
{"id": "seg_measure_having", "tags": ["segment"], "prompt": "Contacts by month for subscriptions that contacted more than twice overall, in month order.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "month"}], "order_by": "asc"}, {"field": "Contacts"}], "segments": [{"name": "Repeat subscriptions", "keys": ["Current Subscription ID"], "measures": ["Contacts"], "filters": [{"field": "Contacts", "predicate": "greater_than", "value": "2"}]}]}, "ordered": true}
{"id": "cross_contact_rate", "tags": ["cross"], "prompt": "Contact rate by call center region.", "spec": {"projections": [{"field": "Call Center Region"}, {"field": "Contact Rate"}]}, "ordered": false}
{"id": "cross_hc_and_contacts", "tags": ["cross"], "prompt": "Help center views and contacts by date.", "spec": {"projections": [{"field": "Date"}, {"field": "# HC Views"}, {"field": "Contacts"}]}, "ordered": false}
{"id": "cross_paid_memberships", "tags": ["cross"], "prompt": "Paid memberships by membership country code.", "spec": {"projections": [{"field": "Membership Agg Country Code"}, {"field": "Paid Memberships"}]}, "ordered": false}
{"id": "cross_hc_helpfulness", "tags": ["cross"], "prompt": "Help center helpfulness percentage by content type.", "spec": {"projections": [{"field": "HC Content Type"}, {"field": "% Helpfulness"}]}, "ordered": false}
{"id": "shape_alias", "tags": ["shape"], "prompt": "Authenticated rate by month, with the rate column named 'Auth %'.", "spec": {"projections": [{"field": "Contact Date", "decorators": [{"type": "truncate", "grain": "month"}]}, {"field": "Authenticated Rate", "alias": "Auth %"}]}, "ordered": false}
{"id": "shape_two_orders", "tags": ["shape"], "prompt": "Contacts by call center region and call center, ordered by region ascending and then by contacts descending.", "spec": {"projections": [{"field": "Call Center Region", "order_by": "asc"}, {"field": "Call Center"}, {"field": "Contacts", "order_by": "desc"}]}, "ordered": true}
{"id": "shape_two_dims_measure_filter", "tags": ["shape"], "prompt": "Contacts by call center and contact channel, only combinations with at least 300 contacts.", "spec": {"projections": [{"field": "Call Center"}, {"field": "Contact Channel"}, {"field": "Contacts"}], "filters": [{"field": "Contacts", "predicate": "greater_than_or_equal_to", "value": "300"}]}, "ordered": false}
