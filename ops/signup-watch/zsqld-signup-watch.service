[Unit]
Description=Mail new 0sql sign-ups since the last check
After=zsqld.service

[Service]
Type=oneshot
EnvironmentFile=/etc/zsqld.env
ExecStart=/usr/local/bin/zsqld-signup-watch
StateDirectory=zsqld-signup-watch
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/zsqld
ReadWritePaths=/var/log/zsqld
