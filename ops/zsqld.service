# The server on the host: `zsql serve`, configured by /etc/zsqld.env
# (ZSQL_* variables; mode 0600) and the data directory systemd owns.
# Installed as /etc/systemd/system/zsqld.service; the unit, its
# environment file and its user keep the name zsqld.
[Unit]
Description=0sql server
Documentation=https://github.com/stratasite/0sql
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=zsqld
Group=zsqld
EnvironmentFile=/etc/zsqld.env
# systemd makes and owns the data directory (StateDirectory); the
# variable points the server at it, since the default is under the
# user's home, which is also pointed there.
Environment=ZSQL_DATA_DIR=/var/lib/zsqld
Environment=ZSQL_HOME=/var/lib/zsqld
ExecStart=/usr/local/bin/zsql serve
StateDirectory=zsqld
StateDirectoryMode=0750
Restart=on-failure
RestartSec=2

# The binary is static and the service wants nothing from the system
# but its own state directory and a loopback socket: no capabilities,
# a read-only filesystem apart from the state directory, a private
# temp directory (a deploy unpacks an archive there), a system call
# filter, and network limited to IPv4, IPv6 and Unix sockets.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
